# Copiar a .env y llenar los valores. El .env NO se sube a Git.
# Lo lee el sync-service al arrancar (spring.config.import).
# No dejar vacía una variable que tiene valor por defecto: un valor vacío le gana al defecto.

DB_REPLICA_HOST=127.0.0.1
DB_REPLICA_PORT=3307
DB_REPLICA_NAME=oficina_agua
DB_REPLICA_USER=lectura
# La clave de lectura definida en oficina-agua-infra/.env
DB_REPLICA_PASSWORD=

SYNC_PAGE_SIZE=500

DYNAMODB_ENDPOINT=http://127.0.0.1:8011
AWS_REGION=us-east-1
# Llaves falsas que acepta DynamoDB Local (no son secretos)
DYNAMODB_ACCESS_KEY=local
DYNAMODB_SECRET_KEY=local